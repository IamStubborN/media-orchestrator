MEDIA_POSTGRES_PASSWORD=replace-me
MEDIA_DATABASE_URL=postgres://media:replace-me@postgres:5432/media_orchestrator
MEDIA_PRIMARY_TOKEN=replace-with-random-token
MEDIA_SECONDARY_TOKEN=replace-with-random-token
MEDIA_RUNNER_TOKEN=replace-with-random-token
MEDIA_LIFECYCLE_TOKEN=replace-with-random-token

MEDIA_BIND_ADDRESS=127.0.0.1
MEDIA_PORT=8080
MEDIA_LIBRARY_ROOT=./.local/media
MEDIA_DRI_DEVICE=/dev/dri

MEDIA_REZKA_MIRRORS=https://rezka.ag
MEDIA_REZKA_SESSION_PROBE_URL=https://rezka.ag/
MEDIA_REZKA_SESSION_VALID_MARKERS_JSON=["logout"]
MEDIA_REZKA_SESSION_INVALID_MARKERS_JSON=["login"]
MEDIA_REZKA_COOKIE_KEY=replace-with-base64-encoded-32-byte-key
# Optional explicit proxy used only by the Rezka client.
MEDIA_REZKA_PROXY_URL=
MEDIA_STORAGE_RESERVE_BYTES=0
